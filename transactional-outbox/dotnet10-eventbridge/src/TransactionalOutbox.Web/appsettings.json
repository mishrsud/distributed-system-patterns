{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "MaxAttempts": 10,
    "LeaseDuration": "00:00:30",
    "IdleDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00",
    "ProcessedRetention": "7.00:00:00",
    "CleanupInterval": "01:00:00"
  },
  "EventBridge": {
    "EventBusName": "orders",
    "Source": "sample.orders",
    "DetailType": "OrderPlaced",
    "ServiceUrl": ""
  }
}
