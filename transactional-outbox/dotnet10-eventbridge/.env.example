# Copy to .env (gitignored): cp .env.example .env
# Disposable local-development value only. Never reuse for a real SQL Server.
MSSQL_SA_PASSWORD=Local_dev_Only_123!

# LocalStack 4.14.0 (default) runs without a token. 2026.x images require a
# LocalStack auth token; to opt in, uncomment both lines and supply your own token.
# LOCALSTACK_IMAGE=localstack/localstack:2026.08.3
# LOCALSTACK_AUTH_TOKEN=
